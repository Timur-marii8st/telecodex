include LICENSE README.md SECURITY.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md
include plugin.json mcp.json requirements.lock
include *.sh
recursive-include docs *.md
recursive-include skills *.md
recursive-include scripts *.py
recursive-include tests *.py
prune private
prune .venv
prune dist
prune build
global-exclude __pycache__ *.py[cod] *.session *.session-* credentials.json authorized.json login-qr.png
